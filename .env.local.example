# ─── Database (Neon) ───────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Auth (NextAuth v5 / Auth.js) ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Email magic-link provider (Resend)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=Prayer Jar <noreply@prayerjar.org>

# Base URL used for email links (set automatically on Vercel; required locally)
NEXTAUTH_URL=http://localhost:3000

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of admin email addresses.
# REQUIRED even locally: `next build` runs with NODE_ENV=production, which trips
# the assertion in src/lib/env.ts. An empty value fails the build.
ADMIN_EMAILS=

# ─── ChMS integration ─────────────────────────────────────────────────────────
# 64-character hex string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also required for local builds — the format is asserted at module load.
# Use a throwaway value locally; never reuse the production key.
CHMS_CONFIG_ENCRYPTION_KEY=

# ─── Cron ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Church Finder (Google Places API) ────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ─── Subdomain Routing (pj-s22-16) ────────────────────────────────────────────
# Set to 'true' ONLY after:
#   1. Wildcard CNAME *.prayerjar.org → cname.vercel-dns.com. added at Porkbun
#   2. *.prayerjar.org added as a domain in Vercel Project Settings → Domains
#   3. Vercel wildcard cert is provisioned (~5 minutes)
# See docs/ops/subdomain-launch-checklist.md for the full checklist.
SUBDOMAIN_ROUTING=false
